# EditorConfig for zig-qm-toolkit-scaffolded projects.
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.zig]
indent_size = 4

[*.{ts,tsx,js,jsx,mjs,cjs,json,jsonc}]
indent_size = 2

[*.{md,mdx}]
indent_size = 2
trim_trailing_whitespace = false

[*.{yaml,yml,toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.sh]
indent_size = 2
